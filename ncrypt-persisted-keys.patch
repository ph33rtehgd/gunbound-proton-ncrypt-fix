+/*
+ * Persisted key storage.
+ *
+ * Keys are stored one per file in %APPDATA%\Microsoft\Crypto\Keys (user keys) or
+ * %ALLUSERSPROFILE%\Microsoft\Crypto\Keys (machine keys), like native Windows does.
+ * The file name is derived from a SHA-256 hash of the upper-cased key name. The private
+ * key blob is protected with DPAPI. The file format is private to Wine.
+ */
+
+#define KEY_FILE_MAGIC   0x4b434e57 /* "WNCK" */
+#define KEY_FILE_VERSION 1
+
+struct key_file_header
+{
+    DWORD magic;
+    DWORD version;
+    DWORD name_size;     /* bytes, including terminating null */
+    DWORD alg_size;      /* bytes, including terminating null */
+    DWORD blob_size;     /* DPAPI protected private key blob */
+    DWORD export_policy;
+    DWORD key_usage;
+    DWORD reserved;
+};
+
+static BOOL create_directories(WCHAR *path, unsigned int skip)
+{
+    WCHAR *p = path + skip;
+
+    while ((p = wcschr(p, '\\')))
+    {
+        *p = 0;
+        if (!CreateDirectoryW(path, NULL) && GetLastError() != ERROR_ALREADY_EXISTS)
+        {
+            *p = '\\';
+            return FALSE;
+        }
+        *p++ = '\\';
+    }
+    return TRUE;
+}
+
+static SECURITY_STATUS get_key_unique_name(const WCHAR *name, WCHAR *unique, DWORD unique_len)
+{
+    static const char hex[] = "0123456789abcdef";
+    UCHAR hash[32];
+    WCHAR *upper;
+    NTSTATUS status;
+    unsigned int i, len = lstrlenW(name);
+
+    if (unique_len < 2 * 16 + ARRAY_SIZE(L"_wine")) return NTE_BUFFER_TOO_SMALL;
+    if (!(upper = malloc((len + 1) * sizeof(WCHAR)))) return NTE_NO_MEMORY;
+    for (i = 0; i <= len; i++) upper[i] = towupper(name[i]);
+    status = BCryptHash(BCRYPT_SHA256_ALG_HANDLE, NULL, 0, (UCHAR *)upper, len * sizeof(WCHAR), hash, sizeof(hash));
+    free(upper);
+    if (status) return map_ntstatus(status);
+
+    for (i = 0; i < 16; i++)
+    {
+        unique[2 * i]     = hex[hash[i] >> 4];
+        unique[2 * i + 1] = hex[hash[i] & 0xf];
+    }
+    lstrcpyW(unique + 32, L"_wine");
+    return ERROR_SUCCESS;
+}
+
+static WCHAR *get_key_path(const WCHAR *name, DWORD flags, BOOL create_dir)
+{
+    const WCHAR *base = (flags & NCRYPT_MACHINE_KEY_FLAG) ? L"%ALLUSERSPROFILE%" : L"%APPDATA%";
+    WCHAR unique[64], dir[MAX_PATH], *path;
+    DWORD len, base_len;
+
+    if (get_key_unique_name(name, unique, ARRAY_SIZE(unique))) return NULL;
+    if (!(base_len = ExpandEnvironmentStringsW(base, dir, ARRAY_SIZE(dir))) || base_len > ARRAY_SIZE(dir))
+    {
+        ERR("could not expand %s\n", debugstr_w(base));
+        return NULL;
+    }
+    base_len--;
+
+    len = base_len + ARRAY_SIZE(L"\\Microsoft\\Crypto\\Keys\\") + lstrlenW(unique) + 1;
+    if (!(path = malloc(len * sizeof(WCHAR)))) return NULL;
+    lstrcpyW(path, dir);
+    lstrcatW(path, L"\\Microsoft\\Crypto\\Keys\\");
+    if (create_dir && !create_directories(path, base_len + 1))
+    {
+        ERR("could not create key directory %s, error %lu\n", debugstr_w(path), GetLastError());
+        free(path);
+        return NULL;
+    }
+    lstrcatW(path, unique);
+    return path;
+}
+
+static BOOL key_file_exists(const WCHAR *name, DWORD flags)
+{
+    WCHAR *path = get_key_path(name, flags, FALSE);
+    DWORD attrs;
+
+    if (!path) return FALSE;
+    attrs = GetFileAttributesW(path);
+    free(path);
+    return attrs != INVALID_FILE_ATTRIBUTES && !(attrs & FILE_ATTRIBUTE_DIRECTORY);
+}
+
+static DWORD get_dword_property(struct object *object, const WCHAR *name, DWORD def)
+{
+    struct object_property *prop = get_object_property(object, name);
+    if (prop && prop->value_size == sizeof(DWORD)) return *(DWORD *)prop->value;
+    return def;
+}
+
+static BOOL write_all(HANDLE file, const void *data, DWORD size)
+{
+    DWORD written;
+    return WriteFile(file, data, size, &written, NULL) && written == size;
+}
+
+static SECURITY_STATUS persist_key(struct object *object)
+{
+    struct key *key = &object->key;
+    struct key_file_header header;
+    DATA_BLOB plain, protected = {0};
+    SECURITY_STATUS ret = NTE_FAIL;
+    NTSTATUS status;
+    WCHAR *path, *tmp_path = NULL;
+    HANDLE file;
+    ULONG size;
+    BYTE *blob;
+
+    status = BCryptExportKey(key->bcrypt_key, NULL, key->desc->blob_type, NULL, 0, &size, 0);
+    if (status) return map_ntstatus(status);
+    if (!(blob = malloc(size))) return NTE_NO_MEMORY;
+    status = BCryptExportKey(key->bcrypt_key, NULL, key->desc->blob_type, blob, size, &size, 0);
+    if (status)
+    {
+        free(blob);
+        return map_ntstatus(status);
+    }
+
+    plain.pbData = blob;
+    plain.cbData = size;
+    if (!CryptProtectData(&plain, L"Wine CNG key", NULL, NULL, NULL,
+                          CRYPTPROTECT_UI_FORBIDDEN |
+                          ((key->flags & NCRYPT_MACHINE_KEY_FLAG) ? CRYPTPROTECT_LOCAL_MACHINE : 0), &protected))
+    {
+        ERR("CryptProtectData failed, error %lu\n", GetLastError());
+        SecureZeroMemory(blob, size);
+        free(blob);
+        return NTE_FAIL;
+    }
+    SecureZeroMemory(blob, size);
+    free(blob);
+
+    if (!(path = get_key_path(key->name, key->flags, TRUE))) goto done;
+    if (!(tmp_path = malloc((lstrlenW(path) + 5) * sizeof(WCHAR)))) goto done;
+    lstrcpyW(tmp_path, path);
+    lstrcatW(tmp_path, L".tmp");
+
+    header.magic         = KEY_FILE_MAGIC;
+    header.version       = KEY_FILE_VERSION;
+    header.name_size     = (lstrlenW(key->name) + 1) * sizeof(WCHAR);
+    header.alg_size      = (lstrlenW(key->desc->name) + 1) * sizeof(WCHAR);
+    header.blob_size     = protected.cbData;
+    header.export_policy = get_dword_property(object, NCRYPT_EXPORT_POLICY_PROPERTY, 0);
+    header.key_usage     = get_dword_property(object, NCRYPT_KEY_USAGE_PROPERTY, NCRYPT_ALLOW_ALL_USAGES);
+    header.reserved      = 0;
+
+    file = CreateFileW(tmp_path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (file == INVALID_HANDLE_VALUE)
+    {
+        ERR("could not create %s, error %lu\n", debugstr_w(tmp_path), GetLastError());
+        goto done;
+    }
+    if (write_all(file, &header, sizeof(header)) &&
+        write_all(file, key->name, header.name_size) &&
+        write_all(file, key->desc->name, header.alg_size) &&
+        write_all(file, protected.pbData, protected.cbData))
+    {
+        CloseHandle(file);
+        if (MoveFileExW(tmp_path, path, MOVEFILE_REPLACE_EXISTING)) ret = ERROR_SUCCESS;
+        else ERR("could not rename %s, error %lu\n", debugstr_w(tmp_path), GetLastError());
+    }
+    else
+    {
+        ERR("could not write %s, error %lu\n", debugstr_w(tmp_path), GetLastError());
+        CloseHandle(file);
+    }
+    if (ret) DeleteFileW(tmp_path);
+    else TRACE("persisted key %s to %s\n", debugstr_w(key->name), debugstr_w(path));
+
+done:
+    LocalFree(protected.pbData);
+    free(tmp_path);
+    free(path);
+    return ret;
+}
+
+static SECURITY_STATUS set_key_name(struct object *object, const WCHAR *name, DWORD flags)
+{
+    WCHAR unique[64];
+    DWORD key_type = flags & NCRYPT_MACHINE_KEY_FLAG;
+    SECURITY_STATUS ret;
+
+    if (!(object->key.name = wcsdup(name))) return NTE_NO_MEMORY;
+    object->key.flags = key_type;
+    if ((ret = get_key_unique_name(name, unique, ARRAY_SIZE(unique)))) return ret;
+    set_string_property(object, NCRYPT_NAME_PROPERTY, name);
+    set_string_property(object, NCRYPT_UNIQUE_NAME_PROPERTY, unique);
+    set_object_property(object, NCRYPT_KEY_TYPE_PROPERTY, (BYTE *)&key_type, sizeof(key_type));
+    return ERROR_SUCCESS;
+}
+
+static void set_rsa_length_properties(struct object *object, DWORD bitlen)
+{
+    set_object_property(object, NCRYPT_LENGTH_PROPERTY, (BYTE *)&bitlen, sizeof(bitlen));
+    set_object_property(object, BCRYPT_PUBLIC_KEY_LENGTH, (BYTE *)&bitlen, sizeof(bitlen));
+}
+
+static SECURITY_STATUS load_key(NCRYPT_PROV_HANDLE provider, const WCHAR *name, DWORD flags, struct object **ret)
+{
+    const struct algorithm_desc *desc;
+    struct key_file_header header;
+    DATA_BLOB protected, plain = {0};
+    struct object *object = NULL;
+    SECURITY_STATUS sec = NTE_BAD_KEYSET;
+    LARGE_INTEGER file_size;
+    NTSTATUS status;
+    BYTE *data = NULL;
+    WCHAR *path;
+    HANDLE file;
+    DWORD read;
+
+    if (!(path = get_key_path(name, flags, FALSE))) return NTE_FAIL;
+    file = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_DELETE, NULL, OPEN_EXISTING, 0, NULL);
+    if (file == INVALID_HANDLE_VALUE)
+    {
+        TRACE("key %s not found (%s)\n", debugstr_w(name), debugstr_w(path));
+        free(path);
+        return NTE_BAD_KEYSET;
+    }
+
+    if (!GetFileSizeEx(file, &file_size) || file_size.QuadPart < sizeof(header) || file_size.QuadPart > 0x100000)
+        goto done;
+    if (!(data = malloc(file_size.LowPart))) { sec = NTE_NO_MEMORY; goto done; }
+    if (!ReadFile(file, data, file_size.LowPart, &read, NULL) || read != file_size.LowPart) goto done;
+
+    memcpy(&header, data, sizeof(header));
+    if (header.magic != KEY_FILE_MAGIC || header.version != KEY_FILE_VERSION ||
+        (ULONGLONG)sizeof(header) + header.name_size + header.alg_size + header.blob_size > read ||
+        header.name_size < sizeof(WCHAR) || header.alg_size < sizeof(WCHAR) ||
+        header.name_size % sizeof(WCHAR) || header.alg_size % sizeof(WCHAR))
+    {
+        WARN("corrupt key file %s\n", debugstr_w(path));
+        goto done;
+    }
+    {
+        WCHAR *alg_name = (WCHAR *)(data + sizeof(header) + header.name_size);
+        alg_name[header.alg_size / sizeof(WCHAR) - 1] = 0;
+        if (!(desc = find_algorithm(alg_name)))
+        {
+            FIXME("unsupported algorithm %s in key file\n", debugstr_w(alg_name));
+            goto done;
+        }
+    }
+
+    protected.pbData = data + sizeof(header) + header.name_size + header.alg_size;
+    protected.cbData = header.blob_size;
+    if (!CryptUnprotectData(&protected, NULL, NULL, NULL, NULL, CRYPTPROTECT_UI_FORBIDDEN, &plain))
+    {
+        ERR("CryptUnprotectData failed, error %lu\n", GetLastError());
+        sec = NTE_BAD_DATA;
+        goto done;
+    }
+
+    if (!(object = create_key_object(desc, provider))) { sec = NTE_NO_MEMORY; goto done; }
+    status = BCryptImportKeyPair(desc->handle, NULL, desc->blob_type, &object->key.bcrypt_key,
+                                 plain.pbData, plain.cbData, 0);
+    if (status)
+    {
+        ERR("could not import persisted key, status %#lx\n", status);
+        sec = map_ntstatus(status);
+        destroy_object(object);
+        object = NULL;
+        goto done;
+    }
+    object->key.finalized = TRUE;
+    if (desc->algid == RSA) set_rsa_length_properties(object, ((BCRYPT_RSAKEY_BLOB *)plain.pbData)->BitLength);
+    set_object_property(object, NCRYPT_EXPORT_POLICY_PROPERTY, (BYTE *)&header.export_policy, sizeof(DWORD));
+    set_object_property(object, NCRYPT_KEY_USAGE_PROPERTY, (BYTE *)&header.key_usage, sizeof(DWORD));
+    if ((sec = set_key_name(object, name, flags)))
+    {
+        BCryptDestroyKey(object->key.bcrypt_key);
+        destroy_object(object);
+        object = NULL;
+        goto done;
+    }
+    *ret = object;
+    sec = ERROR_SUCCESS;
+
+done:
+    if (plain.pbData)
+    {
+        SecureZeroMemory(plain.pbData, plain.cbData);
+        LocalFree(plain.pbData);
+    }
+    free(data);
+    CloseHandle(file);
+    free(path);
+    return sec;
+}
